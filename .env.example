# ==============================================================================
# TRADING AI AGENT CONFIGURATION
# ==============================================================================
# IMPORTANT:
# - Do NOT commit this file with real credentials to source control.
# - The backend alone reads these values; keys are NEVER exposed to the frontend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TRADING MARKET DATA API
# ------------------------------------------------------------------------------
# Set your Trading Data Provider API Key and Base URL.
# Examples of compatible REST endpoints: Finnhub, AlphaVantage, CoinGecko, Polygon, or custom proxy.
TRADING_API_KEY=PASTE_YOUR_TRADING_API_KEY_HERE
TRADING_BASE_URL=PASTE_TRADING_API_BASE_URL_HERE

# ------------------------------------------------------------------------------
# 2. AI MODEL CONFIGURATION (OpenAI-Compatible)
# ------------------------------------------------------------------------------
# Default requested model:
MODEL_NAME=deepseek-ai/DeepSeek-OCR

# API Key for your OpenAI-compatible provider (e.g., DeepSeek, OpenRouter, OpenAI, Groq, Together AI)
AI_API_KEY=PASTE_YOUR_AI_API_KEY_HERE

# Base URL for OpenAI-compatible API (Leave empty for default https://api.openai.com/v1 or set to your provider, e.g., https://api.deepseek.com/v1 or https://openrouter.ai/api/v1)
AI_API_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 3. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
